# Configuration GitHub (optionnel si vous utilisez GitHub CLI)
# Si vous utilisez les scripts avec gh, vous n'avez pas besoin de ces variables
GITHUB_TOKEN=votre_token_personnel_ici
GITHUB_REPO_OWNER=votre-username
GITHUB_REPO_NAME=votre-repo

# Pour utiliser les scripts gh, installez GitHub CLI:
# https://cli.github.com/
# Puis authentifiez-vous avec: gh auth login
